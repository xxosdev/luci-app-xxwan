config main 'main'
	option enabled '0'
	option check_interval '5'
	option fail_threshold '3'
	option restore_threshold '3'
	option global_mode 'auto'
	option strict_enforcement '1'
	option ipv6_enabled '0'

config status 'status'
	option active_nodes ''
	option last_event ''

config advanced 'advanced'
	option conntrack_flush 'always'
	option conntrack_scope 'all'
	option actions_on_boot '0'
	option reload_action 'restart'
	option hook_timeout '15'
	option hook_background '0'
	option webhook_method 'GET'
	option webhook_url ''
	option webhook_headers ''
	option webhook_content_type 'application/json'
	option webhook_payload ''
	option webhook_retries '2'
	option webhook_insecure '0'
	option webhook_force_iface '0'
	option public_ip_url ''
	option public_ip6_url ''
	option notify_down '1'
	option notify_up '1'
	option notify_switch '1'
	option hook_down ''
	option hook_up ''

config interface 'iface_1'
	option ifname 'wan'
	option tier '1'
	option check_type 'ping'
	option check_targets '223.5.5.5 114.114.114.114'

config interface 'iface_2'
	option ifname 'wan2'
	option tier '2'
	option check_type 'ping'
	option check_targets '223.5.5.5 114.114.114.114'